{
  "AllowedHosts": "api.fabu.company.com;localhost",
  "Auth": {
    "Enabled": true
  },
  "AuthSecurity": {
    "AccessTokenCookieName": "fabu_at",
    "RefreshTokenCookieName": "fabu_rt",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "OtpTtlMinutes": 5,
    "PasswordResetTtlMinutes": 10,
    "CookieSecure": true,
    "CookieSameSite": "Lax"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowInSeconds": 60,
    "QueueLimit": 20
  },
  "RedisConfiguration": {
    "Enabled": true,
    "Connection": "redis:6379,password=${REDIS_PASSWORD},abortConnect=false,connectTimeout=5000,syncTimeout=5000"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FabuApi",
      "Environment": "Production"
    }
  }
}
