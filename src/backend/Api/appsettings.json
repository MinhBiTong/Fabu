    "Issuer": "FabuApiIssuer",
    "Audience": "FabuApiClient",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
