  "RateLimiting": {
    "PermitLimit": 5,
    "WindowInSeconds": 60
  },
  "RedisConfiguration": {
    "Enabled": true,
    "Connection": "localhost:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "fabu_route": {
        "ClusterId": "fabu_cluster",
        "Match": {
          "Path": "/fabu/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ],
          "Hosts": [ "localhost" ]
        }
      }
    },
    "Clusters": {
      "fabu_cluster": {
        "Destinations": {
          "fabu_destination": {
            "Address": "http://localhost:5000/"
          }
        }
      }
    }
  },

    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": "Information",
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "FabuApi"
        },
        "Destructure": [ { "Name": "ToString" } ],
        "Filter": [
            {
                "Name": "ByExcluding",
                "Args": {
                    "expression": "SourceContext = 'Microsoft.EntityFrameworkCore.Database.Command' and @m like '%Executed DbCommand%'"
                }
            }
        ],
        "Audit": {
            "Enabled": true,
            "LogFilePath": "Logs/audit-.txt",
            "RollingInterval": "Day"
        }
    }
}