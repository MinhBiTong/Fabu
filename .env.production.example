# Same keys as .env.production. Keep this file as the public template.
# Production: cp .env.production.example .env.production && edit secrets.

COMPOSE_PROJECT_NAME=fabu
IMAGE_TAG=latest
REGISTRY=ghcr.io/your-org

APP_DOMAIN=fabu.company.com
API_DOMAIN=api.fabu.company.com
LETSENCRYPT_EMAIL=devops@fabu.company.com
NEXT_PUBLIC_API_URL=https://api.fabu.company.com

POSTGRES_DB=fabu
POSTGRES_USER=fabu_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
FABU_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=fabu;Username=fabu_app;Password=CHANGE_ME_POSTGRES_PASSWORD;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100;Timeout=15;Command Timeout=30

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RABBITMQ_DEFAULT_USER=fabu_queue
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD

JWT_KEY=CHANGE_ME_LONG_RANDOM_64_CHAR_SECRET
JWT_ISSUER=FabuApiIssuer
JWT_AUDIENCE=FabuApiClient

COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@fabu.company.com

SMS_ENABLED=false
SMS_BASE_URL=https://telecom-provider.example/api
SMS_API_KEY=CHANGE_ME_SMS_API_KEY
SMS_SECRET_KEY=CHANGE_ME_SMS_SECRET
SMS_BRAND_NAME=FABU

AI_CHATBOT_ENABLED=false
GEMINI_API_KEY=CHANGE_ME_GEMINI_KEY

VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_RETURN_URL=https://api.fabu.company.com/api/v1/payment/vnpay-callback

PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=CHANGE_ME

SEQ_FIRSTRUN_ADMINUSERNAME=admin
SEQ_FIRSTRUN_ADMINPASSWORD=CHANGE_ME_SEQ_ADMIN_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

BACKUP_RETENTION_DAYS=14
